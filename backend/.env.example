# Copier ce fichier vers .env et renseigner de vraies valeurs. Ne jamais committer .env.

# Base de données locale (ou hébergée avec une URL complète)
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/new_generation

# Alternative utilisée par le Blueprint Render pour son MySQL privé :
# DATABASE_HOST=<hôte privé Render>
# DATABASE_PORT=3306
# DATABASE_NAME=new_generation
# DATABASE_USER=new_generation_app
# DATABASE_PASSWORD=<secret généré par Render>

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie du refresh token
REFRESH_COOKIE_NAME=ng_refresh_token
REFRESH_COOKIE_SECURE=false
# Mettre REFRESH_COOKIE_SECURE=true en production (HTTPS obligatoire)

# CORS — liste d'origines autorisées séparées par des virgules, jamais de "*" en production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sécurité comptes
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Environnement
ENVIRONMENT=development