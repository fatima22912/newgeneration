# Copier ce fichier vers .env et adapter si besoin.

# URL de base de l'API backend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Mode mock : à true, toutes les pages utilisent des données mockées
# réalistes (src/mocks/) sans avoir besoin du backend démarré.
# Mettre à false pour appeler la vraie API.
VITE_USE_MOCKS=true

# Mode maintenance : à true, affiche une page "site en maintenance" à la
# place de tout le site (boutique, espace propriétaire, espace admin).
VITE_MAINTENANCE_MODE=false
